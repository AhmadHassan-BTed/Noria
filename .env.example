# Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Applicant Profile Parameters
APPLICANT_NAME=Jane Doe
APPLICANT_NATIONALITY=GenericCountry
APPLICANT_DEGREE_TIER=BS Computer Science
APPLICANT_TARGET_FIELDS=Computer Science, Data Science, AI
APPLICANT_RESEARCH_FOCUS=Distributed Systems, Machine Learning

# Notification Target
NOTIFICATION_TARGET=your_phone_number_here

# Optional
JINA_API_KEY=
NODE_ENV=

# Resilience & Robustness Configuration (optional)
MAX_RETRIES=3
RETRY_BACKOFF_MS=1000
CACHE_MAX_SIZE=500
CACHE_TTL_MS=86400000
HEALTH_CHECK_INTERVAL_MS=60000
QUEUE_SCAN_INTERVAL_MS=300000
ENABLE_QUEUE_RETRY=true